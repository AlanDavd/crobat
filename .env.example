# Configuration for the local docker compose stack and the CLI.
#   cp .env.example .env
# Load it into your shell for the CLI:  set -a; source .env; set +a
#
# These values are for LOCAL DEVELOPMENT ONLY. Generate your own with:
#   openssl rand -base64 32

# 32 bytes, base64. Encrypts request headers/bodies at rest (AES-256-GCM).
SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=
# Signs/verifies tenant JWTs (HS256).
JWT_SECRET=dev-only-jwt-secret-change-me

MYSQL_ROOT_PASSWORD=root-dev-only
MYSQL_USER=crobat
MYSQL_PASSWORD=crobat-dev-only

# Executor capacity: in-flight jobs per replica, poll interval, replicas.
EXECUTOR_WORKERS=64
EXECUTOR_POLL=500ms
EXECUTOR_REPLICAS=2

# How long succeeded jobs stay in MySQL before moving to Cassandra.
ARCHIVE_SUCCEEDED_AFTER=1h

# CLI endpoints.
CROBAT_TASK_API=http://localhost:8080
CROBAT_JOB_API=http://localhost:8081
